                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <!--  Quadrilateral Selector in Sidebar  -->
                    <c:QuadrilateralSelector
                        x:Name="QuadrilateralSelectorControl"
                        Margin="0,8,0,0"
                        Visibility="Collapsed" />

