                        ToolTip="Cancel cropping">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="Dismiss24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                </StackPanel>
                <StackPanel
                    x:Name="TransformButtonPanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    d:Visibility="Visible"
                    Orientation="Vertical"
                    Visibility="Collapsed">

                    <Grid
                        x:Name="CustomButtonGrid"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed">
                        <wpfui:Flyout
                            Margin="0,0,0,20"
                            IsOpen="{Binding ElementName=EditToggleButton,
                                             Path=IsChecked,
                                             Mode=TwoWay}"
                            Placement="Top">
                            <Grid x:Name="CustomSizeStackPanel">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Label
                                    Width="80"
                                    VerticalAlignment="Center"
                                    Content="Width"
                                    Target="{Binding ElementName=CustomWidth}" />
                                <wpfui:NumberBox
                                    x:Name="CustomWidth"
                                    Grid.Column="1"
                                    Width="150"
                                    VerticalAlignment="Center"
                                    Minimum="0"
                                    ToolTip="Custom width"
                                    ValueChanged="CustomWidth_ValueChanged"
                                    Value="10" />
                                <Label
                                    Grid.Row="2"
                                    Width="80"
                                    VerticalAlignment="Center"
                                    Content="Height"
                                    Target="{Binding ElementName=CustomHeight}" />
                                <wpfui:NumberBox
                                    x:Name="CustomHeight"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Width="150"
                                    VerticalAlignment="Center"
                                    Minimum="0"
                                    ToolTip="Custom height"
                                    ValueChanged="CustomWidth_ValueChanged"
                                    Value="5" />
                            </Grid>
                        </wpfui:Flyout>
                        <ToggleButton
                            x:Name="EditToggleButton"
                            Width="180"
                            Margin="0,4"
                            HorizontalContentAlignment="Left"
                            ToolTip="Toggle custom aspect ratio input">
                            <StackPanel Orientation="Horizontal">
                                <wpfui:SymbolIcon Margin="0,0,8,0" Symbol="ResizeImage24" />
                                <TextBlock x:Name="AspectRatioTextBox" Text="Ratio: 0.5" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>
                    <ComboBox
                        x:Name="AspectRatioComboBox"
                        Width="180"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        SelectionChanged="AspectRatioComboBox_SelectionChanged"
                        ToolTip="Choose a preset aspect ratio">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="models:AspectRatioItem">
                                <StackPanel Orientation="Horizontal">
                                    <wpfui:SymbolIcon Margin="0,0,10,0" Symbol="{Binding Symbol}" />
                                    <TextBlock Text="{Binding Text}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <local:AspectRatioTransform x:Name="AspectRatioTransformPreview" />
                    <wpfui:Button
                        x:Name="DetectShapeButton"
                        Width="180"
                        Margin="0,6"
                        Appearance="Secondary"
                        Click="DetectShapeButton_Click"
                        Content="Detect Shape"
                        ToolTip="Automatically detect quadrilaterals in the image">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="ShapeIntersect24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
