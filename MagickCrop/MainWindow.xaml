                                </StackPanel>
                            </TabItem>
                        </TabControl>

                    </StackPanel>
                </ScrollViewer>
                <StackPanel
                    x:Name="CropButtonPanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Orientation="Vertical"
                    Visibility="Collapsed">
                    <wpfui:Button
                        x:Name="DetectCropShapeButton"
