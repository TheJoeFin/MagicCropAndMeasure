                        Text="Place 4 corners, then drag the green midpoint handles to match curved edges."
                        TextWrapping="Wrap" />
                    <wpfui:Button
                        x:Name="DetectUnWarpShapeButton"
                        Width="180"
                        Margin="0,6"
                        Appearance="Secondary"
                        Click="DetectUnWarpShapeButton_Click"
                        Content="Detect Shape"
                        ToolTip="Automatically detect a quadrilateral and set corner markers">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="ShapeIntersect24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                    <TextBlock
                        x:Name="UnWarpDetectInfoText"
                        Width="170"
                        Margin="0,2,0,4"
                        FontSize="11"
                        FontStyle="Italic"
                        Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <!--  Quadrilateral Selector for Un-Warp  -->
                    <c:QuadrilateralSelector
                        x:Name="UnWarpQuadrilateralSelectorControl"
                        Margin="0,8,0,0"
                        Visibility="Collapsed" />

                    <StackPanel x:Name="UnWarpActionButtons" Orientation="Vertical">
                        <CheckBox
                            x:Name="LocalUnWarpCheckBox"
                            Margin="0,6"
                            Content="Local correction"
                            IsChecked="False"
                            ToolTip="Correct in place without cropping — the straightened area replaces the original region" />
                        <wpfui:Button
                            x:Name="ApplyUnWarpButton"
                            Width="180"
                            Margin="0,6"
                            Appearance="Primary"
                            Click="ApplyUnWarpButton_Click"
                            Content="Apply Un-Warp"
                            Foreground="White"
                            ToolTip="Straighten the selected curved region">
                            <wpfui:Button.Icon>
                                <wpfui:SymbolIcon Symbol="BorderAll24" />
                            </wpfui:Button.Icon>
                        </wpfui:Button>
                        <wpfui:Button
                            x:Name="CancelUnWarpButton"
                            Width="180"
                            Appearance="Danger"
                            Click="CancelUnWarpButton_Click"
                            Content="Cancel"
                            ToolTip="Cancel un-warp">
                            <wpfui:Button.Icon>
                                <wpfui:SymbolIcon Symbol="Dismiss24" />
                            </wpfui:Button.Icon>
                        </wpfui:Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel
                    x:Name="EdgeCorrectionButtonPanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Orientation="Vertical"
                    Visibility="Collapsed">
                    <TextBlock
                        Margin="0,4"
                        FontWeight="SemiBold"
                        Text="Edge Correction" />
                    <TextBlock
                        Width="170"
                        Margin="0,0,0,8"
                        FontSize="11"
                        Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="Click on the image near any wavy edge to place correction points. Points snap to the nearest edge."
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="EdgeCorrectionPointCountText"
                        Width="170"
                        Margin="0,0,0,4"
                        FontSize="11"
                        Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="Points placed: 0" />
                    <wpfui:Button
                        x:Name="UndoEdgePointButton"
                        Width="180"
                        Margin="0,4"
                        Appearance="Secondary"
                        Click="UndoEdgePointButton_Click"
                        Content="Undo Last Point"
                        ToolTip="Remove the last placed edge point">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="ArrowUndo24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                    <wpfui:Button
                        x:Name="ClearEdgePointsButton"
                        Width="180"
                        Margin="0,4"
                        Appearance="Secondary"
                        Click="ClearEdgePointsButton_Click"
                        Content="Clear All Points"
                        ToolTip="Remove all placed edge points">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="Delete24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                    <wpfui:Button
                        x:Name="ApplyEdgeCorrectionButton"
                        Width="180"
                        Margin="0,6"
                        Appearance="Primary"
                        Click="ApplyEdgeCorrectionButton_Click"
                        Content="Apply Edge Correction"
                        Foreground="White"
                        ToolTip="Straighten the wavy edges using the placed points">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="Square24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                    <wpfui:Button
                        x:Name="CancelEdgeCorrectionButton"
                        Width="180"
                        Appearance="Danger"
                        Click="CancelEdgeCorrectionButton_Click"
                        Content="Cancel"
                        ToolTip="Cancel edge correction">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="Dismiss24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                </StackPanel>
                <StackPanel
                    x:Name="GridStraightenButtonPanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Orientation="Vertical"
                    Visibility="Collapsed">
                    <TextBlock
                        Margin="0,4"
                        FontWeight="SemiBold"
                        Text="Grid Straighten" />
                    <TextBlock
                        Width="170"
                        Margin="0,0,0,8"
                        FontSize="11"
                        Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="Drag grid intersection points to align with features in the image, then click Apply to straighten."
                        TextWrapping="Wrap" />
                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Text="Grid:" />
                        <wpfui:NumberBox
                            x:Name="GridStraightenRowsBox"
                            Width="60"
                            Margin="0,0,4,0"
                            Maximum="12"
                            Minimum="3"
                            SmallChange="1"
                            ToolTip="Number of grid rows"
                            ValueChanged="GridStraightenSizeChanged"
                            Value="4" />
                        <TextBlock
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Text="×" />
                        <wpfui:NumberBox
                            x:Name="GridStraightenColsBox"
                            Width="60"
                            Maximum="12"
                            Minimum="3"
                            SmallChange="1"
                            ToolTip="Number of grid columns"
                            ValueChanged="GridStraightenSizeChanged"
                            Value="4" />
                    </StackPanel>
                    <wpfui:Button
                        x:Name="ResetGridButton"
                        Width="180"
                        Margin="0,4"
                        Appearance="Secondary"
                        Click="ResetGridButton_Click"
                        Content="Reset Grid"
                        ToolTip="Reset all grid points to their original positions">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="ArrowReset24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                    <wpfui:Button
                        x:Name="ApplyGridStraightenButton"
                        Width="180"
                        Margin="0,6"
                        Appearance="Primary"
                        Click="ApplyGridStraightenButton_Click"
                        Content="Apply Straighten"
                        Foreground="White"
                        ToolTip="Straighten the image using the adjusted grid">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="Grid24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                    <wpfui:Button
                        x:Name="CancelGridStraightenButton"
                        Width="180"
                        Appearance="Danger"
                        Click="CancelGridStraightenButton_Click"
                        Content="Cancel"
                        ToolTip="Cancel grid straighten">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="Dismiss24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                </StackPanel>
                <StackPanel
                    x:Name="ObjectEraseButtonPanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Orientation="Vertical"
                    Visibility="Collapsed">
                    <TextBlock
                        Margin="0,4"
                        FontWeight="SemiBold"
                        Text="Object Erase (AI)" />
                    <TextBlock
                        Width="170"
                        Margin="0,0,0,8"
                        FontSize="11"
                        Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="Paint over the objects you want to remove, then click Apply."
                        TextWrapping="Wrap" />
                    <Label Margin="0,4,0,0" Content="Brush Size:" />
                    <Slider
                        x:Name="EraseBrushSizeSlider"
                        Width="150"
                        Maximum="100"
                        Minimum="5"
                        ToolTip="Set brush size for painting the erase mask"
                        ValueChanged="EraseBrushSizeSlider_ValueChanged"
                        Value="30" />
                    <wpfui:Button
                        x:Name="ClearEraseMaskButton"
                        Width="180"
                        Margin="0,6"
                        Click="ClearEraseMaskButton_Click"
                        Content="Clear Mask"
                        ToolTip="Clear the painted mask">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="Delete24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                    <wpfui:Button
                        x:Name="ApplyObjectEraseButton"
                        Width="180"
                        Margin="0,6"
                        Appearance="Primary"
                        Click="ApplyObjectEraseButton_Click"
                        Content="Apply Erase"
                        Foreground="White"
                        ToolTip="Erase the painted objects using AI">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="Eraser24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                    <wpfui:Button
                        x:Name="CancelObjectEraseButton"
                        Width="180"
                        Appearance="Danger"
                        Click="CancelObjectEraseButton_Click"
                        Content="Cancel"
                        ToolTip="Cancel object erase">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="Dismiss24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                </StackPanel>
                <StackPanel
                    x:Name="ResizeButtonsPanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Orientation="Vertical"
                    Visibility="Collapsed">

                    <!--  Current Image Size Display  -->
                    <wpfui:Card Margin="0,6" Padding="12">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,6"
                                FontWeight="SemiBold"
                                Text="Current Size" />
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="CurrentWidthDisplay"
                                    FontFamily="Consolas"
                                    Text="0"
                                    ToolTip="Current image width" />
                                <TextBlock Margin="6,0" Text=" × " />
                                <TextBlock
                                    x:Name="CurrentHeightDisplay"
                                    FontFamily="Consolas"
                                    Text="0"
                                    ToolTip="Current image height" />
                                <TextBlock
                                    x:Name="CurrentUnitsDisplay"
                                    Margin="6,0,0,0"
                                    Text=" px"
                                    ToolTip="Current units" />
                            </StackPanel>
                        </StackPanel>
                    </wpfui:Card>

                    <!--  Size Input Controls  -->
                    <wpfui:Card Margin="0,6" Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    FontWeight="SemiBold"
                                    Text="New Size" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ToggleButton
                                        x:Name="PixelModeToggle"
                                        Width="35"
                                        Height="26"
                                        Margin="0,0,3,0"
                                        Padding="0"
                                        Checked="PixelModeToggle_Checked"
                                        Content="px"
                                        IsChecked="True"
                                        ToolTip="Enter width and height in pixels"
                                        Unchecked="PixelModeToggle_Unchecked" />
                                    <ToggleButton
                                        x:Name="PercentageModeToggle"
                                        Width="35"
                                        Height="26"
                                        Padding="0"
                                        Checked="PercentageModeToggle_Checked"
                                        Content="%"
                                        ToolTip="Enter width and height as a percentage of current size"
                                        Unchecked="PercentageModeToggle_Unchecked" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Vertical">
                                <!--  Width Input  -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock
                                        Margin="0,0,0,3"
                                        FontSize="12"
                                        Text="Width" />
                                    <wpfui:TextBox
                                        x:Name="WidthTextBox"
                                        PlaceholderText="Width"
                                        TextChanged="SizeTextBox_TextChanged"
                                        ToolTip="Enter the new width" />
                                </StackPanel>

                                <!--  Aspect Ratio Lock  -->
                                <ToggleButton
                                    x:Name="AspectRatioLockToggle"
                                    Width="32"
                                    Height="32"
                                    Margin="0,12,0,4"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Checked="AspectRatioLockToggle_Checked"
                                    IsChecked="True"
                                    ToolTip="Lock aspect ratio"
                                    Unchecked="AspectRatioLockToggle_Unchecked">
                                    <wpfui:SymbolIcon x:Name="AspectRatioIcon" Symbol="Link24" />
                                </ToggleButton>

                                <!--  Height Input  -->
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock
                                        Margin="0,0,0,3"
                                        FontSize="12"
                                        Text="Height" />
                                    <wpfui:TextBox
                                        x:Name="HeightTextBox"
                                        PlaceholderText="Height"
                                        TextChanged="SizeTextBox_TextChanged"
                                        ToolTip="Enter the new height" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </wpfui:Card>

                    <!--  Action Buttons  -->
                    <wpfui:Button
                        x:Name="ApplyResizeButton"
                        Width="180"
                        Margin="0,6"
                        Appearance="Primary"
                        Click="ApplyResizeButton_Click"
                        Content="Apply Resize"
                        Foreground="White"
                        ToolTip="Apply resizing with the specified values">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon RenderTransformOrigin="0.5, 0.5" Symbol="Resize24">
                                <wpfui:SymbolIcon.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </wpfui:SymbolIcon.RenderTransform>
                            </wpfui:SymbolIcon>
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                    <wpfui:Button
                        x:Name="CancelResizeButton"
                        Width="180"
                        Appearance="Danger"
                        Click="CancelResizeButton_Click"
                        Content="Cancel"
                        ToolTip="Cancel resizing">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="Dismiss24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                </StackPanel>
                <StackPanel
                    x:Name="SaveAndOpenDestFolderPanel"
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    Orientation="Vertical">
                    <wpfui:Button
                        x:Name="SavePackageButton"
                        Width="180"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Click="SavePackageButton_Click"
                        Content="Save Package..."
                        ToolTip="Save image with measurements as a .mcm package">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="SaveCopy24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <wpfui:Button
                            x:Name="Save"
                            Width="92"
                            Margin="0,8"
                            Click="Save_Click"
                            Content="Save..."
                            ToolTip="Apply Transform, Save, and Preview file">
                            <wpfui:Button.Icon>
                                <wpfui:SymbolIcon Symbol="Save24" />
                            </wpfui:Button.Icon>
                        </wpfui:Button>
                        <wpfui:Button
                            x:Name="CopyToClipboardButton"
                            Width="36"
                            Margin="8,8,0,8"
                            Command="{Binding CopyToClipboardCommand}"
                            ToolTip="Copy the current image to the clipboard (Ctrl+C)">
                            <wpfui:Button.Icon>
                                <wpfui:SymbolIcon Symbol="Copy24" />
                            </wpfui:Button.Icon>
                        </wpfui:Button>

                        <wpfui:Button
                            x:Name="ShareButton"
                            Width="36"
                            Margin="8,8,0,8"
                            HorizontalAlignment="Center"
                            Command="{Binding ShareCommand}"
                            ToolTip="Share the current image using the Windows Share sheet">
                            <wpfui:Button.Icon>
                                <wpfui:SymbolIcon Symbol="Share24" />
                            </wpfui:Button.Icon>
                        </wpfui:Button>
                    </StackPanel>
                    <wpfui:Button
                        x:Name="OpenFolderButton"
                        Width="180"
                        HorizontalAlignment="Center"
                        Command="{Binding OpenFolderCommand}"
                        Content="Open Folder"
                        IsEnabled="False"
                        ToolTip="Open Folder Where File Was Saved">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="FolderArrowRight24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                </StackPanel>
            </Grid>
        </Border>
        <wpfui:ProgressRing
            x:Name="IsWorkingBar"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="#0066FF"
            IsIndeterminate="True"
            ToolTip="Processing..."
            Visibility="{Binding IsBusy,
                                 Converter={StaticResource BoolToVis}}" />

        <ContentPresenter
            x:Name="Presenter"
            Grid.Row="1"
            Grid.ColumnSpan="3" />
    </Grid>
</wpfui:FluentWindow>
