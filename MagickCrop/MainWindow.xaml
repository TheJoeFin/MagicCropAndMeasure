                            <wpfui:SymbolIcon Symbol="DocumentSplitHint24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                    <wpfui:Button
                        x:Name="CancelTriFoldButton"
                        Width="180"
                        Appearance="Danger"
                        Click="CancelTriFoldButton_Click"
                        Content="Cancel"
                        ToolTip="Cancel tri-fold correction">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="Dismiss24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
