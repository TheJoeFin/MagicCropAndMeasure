                                Margin="0,6,0,0"
                                Appearance="Primary"
                                Click="ApplyConstructionToTransform_Click"
                                Content="Use for Transform"
                                IsEnabled="False"
                                ToolTip="Move the perspective corner handles to the constructed corners" />
                        </StackPanel>
