                        Margin="0,8,0,0"
                        Padding="0,6"
                        Header="Construction (Parametric)"
                        Visibility="Collapsed">
                        <StackPanel x:Name="ConstructionToolsPanelTransform" HorizontalAlignment="Center">
                            <ToggleButton
                                x:Name="ConstructionEdgeToggleTransform"
                                Width="150"
                                Margin="0,4"
                                Checked="ToolSelector_Checked"
                                Click="ToolSelector_Clicked"
                                Tag="ConstructionEdge"
                                ToolTip="Drag along an object's edge to lay down an edge line. Release on an existing point to reuse it."
                                Unchecked="ToolSelector_Unchecked">
                                <ToggleButton.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <wpfui:SymbolIcon Margin="0,0,8,0" Symbol="Line24" />
                                        <TextBlock VerticalAlignment="Center" Text="Draw Edge" />
                                    </StackPanel>
                                </ToggleButton.Content>
                            </ToggleButton>
                            <ToggleButton
                                x:Name="ConstructionPointToggleTransform"
                                Width="150"
                                Margin="0,4"
                                Checked="ToolSelector_Checked"
                                Click="ToolSelector_Clicked"
                                Tag="ConstructionPoint"
                                ToolTip="Click to place a construction point. Clicking an existing point selects it instead."
                                Unchecked="ToolSelector_Unchecked">
                                <ToggleButton.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <wpfui:SymbolIcon Margin="0,0,8,0" Symbol="Circle24" />
                                        <TextBlock VerticalAlignment="Center" Text="Add Point" />
                                    </StackPanel>
                                </ToggleButton.Content>
                            </ToggleButton>
                            <ToggleButton
                                x:Name="ConstructionLineToggleTransform"
                                Width="150"
                                Margin="0,4"
                                Checked="ToolSelector_Checked"
                                Click="ToolSelector_Clicked"
                                Tag="ConstructionLine"
                                ToolTip="Click two points to connect them, then keep clicking to chain more edges"
                                Unchecked="ToolSelector_Unchecked">
                                <ToggleButton.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <wpfui:SymbolIcon Margin="0,0,8,0" Symbol="Connector24" />
                                        <TextBlock VerticalAlignment="Center" Text="Connect Points" />
                                    </StackPanel>
                                </ToggleButton.Content>
                            </ToggleButton>
                            <ToggleButton
                                x:Name="ConstructionBoundaryToggleTransform"
                                Width="150"
                                Margin="0,4"
                                Checked="ToolSelector_Checked"
                                Click="ToolSelector_Clicked"
                                Tag="ConstructionBoundary"
                                ToolTip="Drag a short line across an edge, from one side to the other. The point lands on the transition between the two sides rather than where you released."
                                Unchecked="ToolSelector_Unchecked">
                                <ToggleButton.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <wpfui:SymbolIcon Margin="0,0,8,0" Symbol="TargetAdd24" />
                                        <TextBlock VerticalAlignment="Center" Text="Find Edge Point" />
                                    </StackPanel>
                                </ToggleButton.Content>
