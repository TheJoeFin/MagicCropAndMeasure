                                        </StackPanel>
                                    </GroupBox>
                                    <Button
                                        x:Name="CleanWhiteboardButton"
                                        Width="150"
                                        Margin="0,4"
                                        HorizontalAlignment="Center"
                                        Click="CleanWhiteboardButton_Click"
                                        ToolTip="Remove small dirty marks and speckles from the whiteboard image">
                                        <StackPanel Orientation="Horizontal">
                                            <wpfui:SymbolIcon Margin="0,0,8,0" Symbol="Eraser24" />
                                            <TextBlock VerticalAlignment="Center" Text="Clean Whiteboard" />
                                        </StackPanel>
                                    </Button>
                                    <wpfui:ProgressRing
                                        x:Name="CleanWhiteboardProgressRing"
                                        Width="24"
                                        Height="24"
                                        Margin="0,4"
                                        HorizontalAlignment="Center"
                                        Visibility="Collapsed" />
                                    <Button
                                        x:Name="FillHollowStrokesButton"
                                        Width="150"
                                        Margin="0,4"
                                        HorizontalAlignment="Center"
                                        Click="FillHollowStrokesButton_Click"
