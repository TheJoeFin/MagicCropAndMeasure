                        x:Name="ApplyTriFoldButton"
                        Width="180"
                        Margin="0,6"
                        Appearance="Primary"
                        Click="ApplyTriFoldButton_Click"
                        Content="Apply Tri-Fold"
                        Foreground="White"
                        ToolTip="Apply the tri-fold perspective correction">
