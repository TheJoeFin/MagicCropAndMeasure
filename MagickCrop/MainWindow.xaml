                                                <ToggleButton
                                                    x:Name="ColorOrangeRed"
                                                    Width="28"
                                                    Height="28"
                                                    Margin="2"
                                                    Background="OrangeRed"
                                                    Checked="MarkupColorButton_Checked"
                                                    Tag="OrangeRed"
                                                    ToolTip="Orange Red" />
                                                <ToggleButton
                                                    x:Name="ColorYellow"
                                                    Width="28"
                                                    Height="28"
                                                    Margin="2"
                                                    Background="Yellow"
                                                    Checked="MarkupColorButton_Checked"
                                                    Tag="Yellow"
                                                    ToolTip="Yellow" />
                                                <ToggleButton
                                                    x:Name="ColorLime"
                                                    Width="28"
                                                    Height="28"
                                                    Margin="2"
                                                    Background="LimeGreen"
                                                    Checked="MarkupColorButton_Checked"
                                                    Tag="LimeGreen"
                                                    ToolTip="Lime Green" />
                                                <ToggleButton
                                                    x:Name="ColorCyan"
                                                    Width="28"
                                                    Height="28"
                                                    Margin="2"
                                                    Background="Cyan"
                                                    Checked="MarkupColorButton_Checked"
                                                    Tag="Cyan"
                                                    ToolTip="Cyan" />
                                                <ToggleButton
                                                    x:Name="ColorBlue"
                                                    Width="28"
                                                    Height="28"
                                                    Margin="2"
                                                    Background="DodgerBlue"
                                                    Checked="MarkupColorButton_Checked"
                                                    Tag="DodgerBlue"
                                                    ToolTip="Blue" />
                                                <ToggleButton
                                                    x:Name="ColorPurple"
                                                    Width="28"
                                                    Height="28"
                                                    Margin="2"
                                                    Background="MediumPurple"
                                                    Checked="MarkupColorButton_Checked"
                                                    Tag="MediumPurple"
                                                    ToolTip="Purple" />
                                                <ToggleButton
                                                    x:Name="ColorPink"
                                                    Width="28"
                                                    Height="28"
                                                    Margin="2"
                                                    Background="DeepPink"
                                                    Checked="MarkupColorButton_Checked"
                                                    Tag="DeepPink"
                                                    ToolTip="Pink" />
                                                <ToggleButton
                                                    x:Name="ColorWhite"
                                                    Width="28"
                                                    Height="28"
                                                    Margin="2"
                                                    Background="White"
                                                    Checked="MarkupColorButton_Checked"
                                                    Tag="White"
                                                    ToolTip="White" />
                                                <ToggleButton
                                                    x:Name="ColorBlack"
                                                    Width="28"
                                                    Height="28"
                                                    Margin="2"
                                                    Background="Black"
                                                    Checked="MarkupColorButton_Checked"
