                                            <wpfui:SymbolIcon Margin="0,0,8,0" Symbol="Wand24" />
                                            <TextBlock VerticalAlignment="Center" Text="Convert to Ink" />
                                        </StackPanel>
                                    </Button>
                                    <wpfui:ProgressRing
                                        x:Name="ConvertToInkProgressRing"
                                        Width="24"
                                        Height="24"
                                        Margin="0,4"
                                        HorizontalAlignment="Center"
                                        Visibility="Collapsed" />

                                    <ToggleButton
                                        x:Name="HideMarkupToggle"
                                        Width="150"
                                        Margin="0,4"
                                        HorizontalAlignment="Center"
                                        Checked="HideMarkupToggle_Checked"
                                        ToolTip="Hide all markup on the image"
                                        Unchecked="HideMarkupToggle_Unchecked">
                                        <ToggleButton.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <wpfui:SymbolIcon Margin="0,0,8,0" Symbol="EyeOff24" />
                                                <TextBlock VerticalAlignment="Center" Text="Hide All" />
                                            </StackPanel>
                                        </ToggleButton.Content>
                                    </ToggleButton>

                                    <wpfui:HyperlinkButton
                                        x:Name="ClearMarkupButton"
                                        HorizontalAlignment="Center"
                                        Appearance="Danger"
                                        Click="ClearMarkupButton_Click"
