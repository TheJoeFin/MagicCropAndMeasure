                        Margin="0,8"
                        Appearance="Secondary"
                        Click="DetectCropShapeButton_Click"
                        Content="Detect Shape"
                        ToolTip="Automatically detect a shape in the image and set the crop area">
                        <wpfui:Button.Icon>
                            <wpfui:SymbolIcon Symbol="ShapeIntersect24" />
                        </wpfui:Button.Icon>
                    </wpfui:Button>
                    <TextBlock
                        x:Name="CropDetectInfoText"
                        Width="170"
                        Margin="0,2,0,4"
                        FontSize="11"
                        FontStyle="Italic"
                        Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <!--  Quadrilateral Selector for Crop  -->
                    <c:QuadrilateralSelector
                        x:Name="CropQuadrilateralSelectorControl"
                        Margin="0,8,0,0"
                        Visibility="Collapsed" />

                    <wpfui:Button
                        x:Name="ApplyCropButton"
