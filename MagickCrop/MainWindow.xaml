<wpfui:FluentWindow
    x:Class="MagickCrop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:MagickCrop.Behaviors"
    xmlns:c="clr-namespace:MagickCrop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MagickCrop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:MagickCrop.Models"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Magick Crop &amp; Measure"
    Width="1000"
    Height="800"
    AllowDrop="True"
    MouseMove="TopLeft_MouseMove"
    PreviewDragOver="FluentWindow_PreviewDragOver"
    PreviewDrop="FluentWindow_PreviewDrop"
    PreviewKeyDown="FluentWindow_PreviewKeyDown"
    PreviewKeyUp="FluentWindow_PreviewKeyUp"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="Ellipse">
            <Setter Property="Height" Value="12" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Setter Property="Fill" Value="#0066FF" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
        <Style
            x:Key="SmallToggleButton"
            BasedOn="{StaticResource {x:Type ToggleButton}}"
            TargetType="ToggleButton">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinWidth" Value="100" />
        </Style>
        <!--  Small circular "jump to neighbouring handle" buttons drawn beside transform gizmos  -->
        <Style TargetType="c:CornerNavButton">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Panel.ZIndex" Value="900" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="c:CornerNavButton">
                        <Border
                            x:Name="NavBackground"
                            Background="#E60F1115"
                            BorderBrush="#FF0066FF"
                            BorderThickness="1.5"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBackground" Property="Background" Value="#FF0066FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!--  Add a style for narrow Tab Headers  -->
        <Style
            x:Key="NarrowTabHeaderStyle"
            BasedOn="{StaticResource {x:Type TabItem}}"
            TargetType="TabItem">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Width" Value="60" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!--  Style for the standalone floating sidebar toggle button, positioned just left of the tools pane  -->
        <Style x:Key="SidebarTabToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{wpfui:ThemeResource ApplicationBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{wpfui:ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{wpfui:ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="8"
                                    Opacity="0.3"
                                    ShadowDepth="1" />
                            </Border.Effect>
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="SidebarColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <wpfui:TitleBar
            x:Name="wpfuiTitleBar"
            Title="{Binding WindowTitle}"
            Grid.ColumnSpan="3"
            Height="32"
            Background="{wpfui:ThemeResource ApplicationBackgroundBrush}"
            Foreground="{wpfui:ThemeResource TextFillColorPrimaryBrush}">
            <wpfui:TitleBar.Resources>
                <Style BasedOn="{StaticResource {x:Type wpfui:TitleBarButton}}" TargetType="wpfui:TitleBarButton">
                    <Setter Property="ButtonsForeground" Value="White" />
                    <Setter Property="MouseOverButtonsForeground" Value="Yellow" />
                </Style>
            </wpfui:TitleBar.Resources>
            <wpfui:TitleBar.Icon>
                <wpfui:ImageIcon Source="/Iconv3.ico" />
            </wpfui:TitleBar.Icon>
        </wpfui:TitleBar>

        <Grid
            x:Name="MainGrid"
            Grid.Row="1"
            Grid.Column="0"
            behaviors:PinchZoomBehavior.IsEnabled="True"
            behaviors:PinchZoomBehavior.MaxScale="8"
            behaviors:PinchZoomBehavior.MinScale="0.1"
            behaviors:PinchZoomBehavior.ZoomElement="{Binding ElementName=ShapeCanvas}"
            Background="Gray"
            ClipToBounds="True"
            IsManipulationEnabled="True"
            PreviewMouseDown="MainGrid_PreviewMouseDown"
            PreviewMouseUp="MainGrid_PreviewMouseUp"
            PreviewMouseWheel="ShapeCanvas_PreviewMouseWheel">
            <Grid.ContextMenu>
                <ContextMenu Opened="CanvasContextMenu_Opened">
                    <MenuItem
                        x:Name="ToggleCanvasNavigationMenuItem"
                        Click="ToggleCanvasNavigationMenuItem_Click"
                        Header="Show canvas controls"
                        IsCheckable="True" />
                    <MenuItem
                        x:Name="ToggleMiniMapMenuItem"
                        Click="ToggleMiniMapMenuItem_Click"
                        Header="Show mini map"
                        IsCheckable="True" />
                </ContextMenu>
            </Grid.ContextMenu>
            <Canvas x:Name="ShapeCanvas" Margin="50,50,0,0">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="canvasScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="canvasTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Grid x:Name="ImageGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Image
                        x:Name="MainImage"
                        MouseDown="ShapeCanvas_MouseDown"
                        Stretch="Uniform" />
                    <InkCanvas
                        x:Name="DrawingCanvas"
                        Background="Transparent"
                        IsEnabled="False"
                        IsHitTestVisible="False"
                        StrokeCollected="DrawingCanvas_StrokeCollected" />
                    <InkCanvas
                        x:Name="EraseMaskCanvas"
                        Background="Transparent"
                        IsEnabled="False"
                        IsHitTestVisible="False"
                        Visibility="Collapsed" />
                    <InkCanvas
                        x:Name="MarkupCanvas"
                        Background="Transparent"
                        IsEnabled="False"
                        IsHitTestVisible="False"
                        SelectionMoved="MarkupCanvas_SelectionMoved"
                        SelectionMoving="MarkupCanvas_SelectionMoving"
                        SelectionResized="MarkupCanvas_SelectionResized"
                        SelectionResizing="MarkupCanvas_SelectionResizing"
                        StrokeCollected="MarkupCanvas_StrokeCollected"
                        StrokeErasing="MarkupCanvas_StrokeErasing" />
                    <ResizeGrip
                        x:Name="ImageResizeGrip"
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="#0066FF"
                        Cursor="SizeAll"
                        IsManipulationEnabled="True"
                        MouseDown="ImageResizeGrip_MouseDown"
                        ToolTip="Resize handle"
                        Visibility="Hidden" />
                </Grid>

                <Ellipse
                    x:Name="TopLeft"
                    Canvas.Left="100"
                    Canvas.Top="100"
                    MouseDown="TopLeft_MouseDown"
                    Tag="0"
                    ToolTip="Drag to move top-left marker" />
                <Ellipse
                    x:Name="TopRight"
                    Canvas.Left="700"
                    Canvas.Top="100"
                    MouseDown="TopLeft_MouseDown"
                    Tag="1"
                    ToolTip="Drag to move top-right marker" />
                <Ellipse
                    x:Name="BottomRight"
                    Canvas.Left="700"
                    Canvas.Top="525"
                    MouseDown="TopLeft_MouseDown"
                    Tag="2"
                    ToolTip="Drag to move bottom-right marker" />
                <Ellipse
                    x:Name="BottomLeft"
                    Canvas.Left="100"
                    Canvas.Top="525"
                    MouseDown="TopLeft_MouseDown"
                    Tag="3"
                    ToolTip="Drag to move bottom-left marker" />

                <!--  Tri-fold correction markers (upper and lower fold lines)  -->
                <Ellipse
                    x:Name="UpperFoldLeft"
                    Canvas.Left="100"
                    Canvas.Top="240"
                    Fill="#FF8C00"
                    MouseDown="TopLeft_MouseDown"
                    Tag="4"
                    ToolTip="Drag to move upper fold left marker"
                    Visibility="Collapsed" />
                <Ellipse
                    x:Name="UpperFoldRight"
                    Canvas.Left="700"
                    Canvas.Top="240"
                    Fill="#FF8C00"
                    MouseDown="TopLeft_MouseDown"
                    Tag="5"
                    ToolTip="Drag to move upper fold right marker"
                    Visibility="Collapsed" />
                <Ellipse
                    x:Name="LowerFoldLeft"
                    Canvas.Left="100"
                    Canvas.Top="385"
                    Fill="#FF8C00"
                    MouseDown="TopLeft_MouseDown"
                    Tag="6"
                    ToolTip="Drag to move lower fold left marker"
                    Visibility="Collapsed" />
                <Ellipse
                    x:Name="LowerFoldRight"
                    Canvas.Left="700"
                    Canvas.Top="385"
                    Fill="#FF8C00"
                    MouseDown="TopLeft_MouseDown"
                    Tag="7"
                    ToolTip="Drag to move lower fold right marker"
                    Visibility="Collapsed" />

                <!--  Un-warp midpoint markers (one per edge)  -->
                <Ellipse
                    x:Name="UnWarpMidTop"
                    Canvas.Left="400"
                    Canvas.Top="100"
                    Fill="#00CC88"
                    MouseDown="TopLeft_MouseDown"
                    Tag="8"
                    ToolTip="Drag to curve the top edge"
                    Visibility="Collapsed" />
                <Ellipse
                    x:Name="UnWarpMidRight"
                    Canvas.Left="700"
                    Canvas.Top="310"
                    Fill="#00CC88"
                    MouseDown="TopLeft_MouseDown"
                    Tag="9"
                    ToolTip="Drag to curve the right edge"
                    Visibility="Collapsed" />
                <Ellipse
                    x:Name="UnWarpMidBottom"
                    Canvas.Left="400"
                    Canvas.Top="525"
                    Fill="#00CC88"
                    MouseDown="TopLeft_MouseDown"
                    Tag="10"
                    ToolTip="Drag to curve the bottom edge"
                    Visibility="Collapsed" />
                <Ellipse
                    x:Name="UnWarpMidLeft"
                    Canvas.Left="100"
                    Canvas.Top="310"
                    Fill="#00CC88"
                    MouseDown="TopLeft_MouseDown"
                    Tag="11"
                    ToolTip="Drag to curve the left edge"
                    Visibility="Collapsed" />

                <local:ResizableRectangle x:Name="CroppingRectangle" Visibility="Collapsed" />
                <local:ResizableRectangle x:Name="LocalAdjustmentRectangle" Visibility="Collapsed" />

                <!--  Rubber-band marquee for the Markup "Select" tool (ink + shapes + text)  -->
                <Rectangle
                    x:Name="MarkupMarqueeRectangle"
                    Panel.ZIndex="2000"
                    Fill="#330066FF"
                    IsHitTestVisible="False"
                    Stroke="#0066FF"
                    StrokeDashArray="4 2"
                    StrokeThickness="1"
                    Visibility="Collapsed" />
            </Canvas>

            <!--  Pixel Precision Zoom Control - Outside ShapeCanvas to avoid being affected by canvas zoom  -->
            <c:PixelPrecisionZoom
                x:Name="PixelZoomControl"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="1000"
                Visibility="Collapsed" />

            <!--  Rotation angle overlay label  -->
            <TextBlock
                x:Name="RotationOverlayLabel"
                Margin="60,10,0,0"
                Padding="4,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#66000000"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="White"
                IsHitTestVisible="False"
                Text="0°"
                Visibility="Collapsed" />

            <Border
                x:Name="CanvasNavigationBar"
                Margin="12"
                Padding="10,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Panel.ZIndex="1001"
                Background="#F01E2026"
                BorderBrush="#806A6D78"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasImage,
                                     Converter={StaticResource BoolToVis}}">
                <Border.ContextMenu>
                    <ContextMenu Opened="CanvasContextMenu_Opened">
                        <MenuItem
                            x:Name="ToggleCanvasNavigationBarMenuItem"
                            Click="ToggleCanvasNavigationMenuItem_Click"
                            Header="Show canvas controls"
                            IsCheckable="True" />
                        <MenuItem
                            x:Name="ToggleMiniMapBarMenuItem"
                            Click="ToggleMiniMapMenuItem_Click"
                            Header="Show mini map"
                            IsCheckable="True" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="12"
                        Opacity="0.35"
                        ShadowDepth="2" />
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="#FFF4F4F5"
                        Text="Canvas" />
                    <Border
                        Width="1"
                        Height="22"
                        Margin="0,0,10,0"
                        Background="#4DFFFFFF" />
                    <wpfui:Button
                        Padding="8,3"
                        Appearance="Secondary"
                        Click="ResetCanvasNavigationButton_Click"
                        Content="Reset"
                        ToolTip="Reset zoom and pan" />
                    <wpfui:Button
                        Margin="6,0,0,0"
                        Padding="8,3"
                        Appearance="Secondary"
                        Click="FitImageButton_Click"
                        Content="Fit image"
                        ToolTip="Fit the entire image in the canvas" />
                    <wpfui:Button
                        Margin="6,0,0,0"
                        Padding="8,3"
                        Appearance="Secondary"
                        Click="FitTransformButton_Click"
                        Content="Fit transform"
                        ToolTip="Fit the active transform bounds in the canvas" />
                    <Border
                        Width="1"
                        Height="22"
                        Margin="12,0"
                        Background="#4DFFFFFF" />
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Foreground="#FFD1D5DB"
                        Text="Bounds" />
                    <ToggleButton
                        x:Name="AllowOutsideImageToggle"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Checked="AllowOutsideImageToggle_Changed"
                        Content="Allow outside"
                        IsChecked="True"
                        ToolTip="Allow transform handles to be placed beyond the image edge"
                        Unchecked="AllowOutsideImageToggle_Changed" />
                    <Border
                        Width="1"
                        Height="22"
                        Margin="12,0"
                        Background="#4DFFFFFF" />
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Foreground="#FFD1D5DB"
                        Text="Zoom" />
                    <TextBlock
                        x:Name="CanvasZoomText"
                        Width="48"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="#FFF4F4F5"
                        Text="100%"
                        TextAlignment="Right" />
                    <Slider
                        x:Name="CanvasZoomSlider"
                        Width="170"
                        Maximum="10"
                        Minimum="0.1"
                        SmallChange="0.05"
                        TickFrequency="0.1"
                        ToolTip="Canvas zoom"
                        ValueChanged="CanvasZoomSlider_ValueChanged"
                        Value="1" />
                    <StackPanel
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTip="Processing..."
                        Visibility="{Binding IsBusy,
                                             Converter={StaticResource BoolToVis}}">
                        <wpfui:ProgressRing
                            Width="16"
                            Height="16"
                            IsIndeterminate="True" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="#FFD1D5DB"
                            Text="Working" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Mini map showing where the viewport sits within the image  -->
            <c:MiniMap
                x:Name="CanvasMiniMap"
                Margin="12,12,12,66"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Panel.ZIndex="1002"
                Visibility="Collapsed" />

            <!--  White point color preview  -->
            <Border
                x:Name="WhitePointColorPreview"
                Width="80"
                Height="80"
                Margin="60,10,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                BorderBrush="White"
                BorderThickness="2"
                CornerRadius="4"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="10"
                        Opacity="0.5"
                        ShadowDepth="2" />
                </Border.Effect>
                <Grid>
                    <Rectangle x:Name="WhitePointColorRectangle" Fill="White" />
                    <TextBlock
                        Margin="4"
                        Padding="4,2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="#AA000000"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Picked Color" />
                </Grid>
            </Border>
        </Grid>

        <c:WelcomeMessage
            x:Name="WelcomeMessageModal"
            Grid.Row="1"
            CameraButtonEvent="CameraButton_Click"
            OverlayButtonEvent="OverlayButton_Click"
            PasteButtonEvent="PasteButton_Click"
            PrimaryButtonEvent="OpenFileButton_Click" />

        <ToggleButton
            x:Name="SidebarToggleButton"
            Grid.Row="1"
            Grid.Column="0"
            Width="22"
            Height="88"
            Margin="0,4,4,0"
            Padding="2,10"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Checked="SidebarToggleButton_Checked"
            IsChecked="True"
            Style="{StaticResource SidebarTabToggleButtonStyle}"
            ToolTip="Collapse tools sidebar"
            Unchecked="SidebarToggleButton_Unchecked"
            Visibility="Collapsed">
            <TextBlock
                x:Name="SidebarToggleText"
                FontSize="11"
                Text="Hide tools">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="-90" />
                </TextBlock.LayoutTransform>
            </TextBlock>
        </ToggleButton>

        <Border
            x:Name="BottomBorder"
            Grid.Row="1"
            Grid.Column="2"
            Padding="12,12"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{wpfui:ThemeResource ApplicationBackgroundBrush}"
            Visibility="Collapsed">
            <Grid x:Name="BottomPane">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <ScrollViewer>
                    <StackPanel MinWidth="200" Orientation="Vertical">
                        <Grid Width="160">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <wpfui:SymbolIcon
                                x:Name="ImageIconOpenedName"
                                Grid.Column="0"
                                Margin="0,0,5,0"
                                Symbol="Image24"
                                ToolTip="Currently opened image" />
                            <TextBlock
                                x:Name="ReOpenFileText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{Binding OpenedFileDisplayName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="Opened image file name" />
                            <wpfui:SymbolIcon
                                x:Name="CloseFileIcon"
                                Grid.Column="2"
                                Margin="5,0,0,0"
                                MouseDown="CloseFileIcon_MouseDown"
                                Symbol="Dismiss24"
                                ToolTip="Click to close and show the welcome screen"
                                Visibility="{Binding HasOpenedFileName,
                                                     Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <StackPanel
                            x:Name="UndoRedoPanel"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <MenuItem
                                x:Name="UndoMenuItem"
                                Command="{Binding UndoCommand}"
                                Header="Undo"
                                ToolTip="Undo last action">
                                <MenuItem.Icon>
                                    <wpfui:SymbolIcon Symbol="ArrowUndo24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                x:Name="RedoMenuItem"
                                Command="{Binding RedoCommand}"
                                Header=""
                                ToolTip="Redo last undone action">
                                <MenuItem.Icon>
                                    <wpfui:SymbolIcon Symbol="ArrowRedo24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                x:Name="ResetMenuItem"
                                Click="ResetToOriginalMenuItem_Click"
                                Header=""
                                IsEnabled="{Binding HasImage}"
                                ToolTip="Reset to the original image, discarding all edits and measurements">
                                <MenuItem.Icon>
                                    <wpfui:SymbolIcon Symbol="ArrowReset24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                x:Name="InfoMenuItem"
                                Command="{Binding ShowAboutCommand}"
                                Header=""
                                ToolTip="About Magick Crop &amp; Measure">
                                <MenuItem.Icon>
                                    <wpfui:SymbolIcon Symbol="Info24" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </StackPanel>
                        <TextBlock Text="Tools" />
                        <TabControl ItemContainerStyle="{StaticResource NarrowTabHeaderStyle}" SelectionChanged="ToolsTabControl_SelectionChanged">
                            <TabItem x:Name="TransformTabItem">
                                <TabItem.Header>
                                    <wpfui:SymbolIcon Symbol="Crop24" ToolTip="Crop and transform" />
                                </TabItem.Header>
                                <StackPanel Orientation="Vertical">
                                    <MenuItem
                                        Name="Rotate90CwMenuItem"
                                        Command="{Binding Rotate90CwCommand}"
                                        Header="Rotate 90° CW"
                                        ToolTip="Rotate 90 degrees clockwise">
                                        <MenuItem.Icon>
                                            <wpfui:SymbolIcon Symbol="RotateRight24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Name="Rotate90CcwMenuItem"
                                        Command="{Binding Rotate90CcwCommand}"
                                        Header="Rotate 90° CCW"
                                        ToolTip="Rotate 90 degrees counter-clockwise">
                                        <MenuItem.Icon>
                                            <wpfui:SymbolIcon Symbol="RotateLeft24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Name="PreciseRotateMenuItem"
                                        Click="PreciseRotateMenuItem_Click"
                                        Header="Rotate (Precise)"
                                        ToolTip="Rotate image by arbitrary angle">
                                        <MenuItem.Icon>
                                            <wpfui:SymbolIcon Symbol="ArrowRotateClockwise24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <StackPanel
                                        x:Name="RotateControlsPanel"
                                        Margin="0,4,0,8"
                                        Visibility="Collapsed">
                                        <Border
                                            Padding="8"
                                            BorderBrush="#2A2A2A"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock
                                                    Margin="0,0,0,6"
                                                    FontWeight="SemiBold"
                                                    Text="Rotation" />
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="60" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider
                                                        x:Name="RotateAngleSlider"
                                                        Margin="0,0,8,0"
                                                        IsSnapToTickEnabled="False"
                                                        LargeChange="5"
                                                        Maximum="180"
                                                        Minimum="-180"
                                                        SmallChange="0.1"
                                                        TickFrequency="15"
                                                        ValueChanged="RotateAngleSlider_ValueChanged" />
                                                    <wpfui:NumberBox
                                                        x:Name="RotateAngleNumberBox"
                                                        Grid.Column="1"
                                                        HorizontalContentAlignment="Center"
                                                        Maximum="180"
                                                        Minimum="-180"
                                                        SmallChange="0.1"
                                                        ValueChanged="RotateAngleNumberBox_ValueChanged"
                                                        Value="0" />
                                                </Grid>
                                                <ToggleButton
                                                    x:Name="FreeRotateToggle"
                                                    Margin="0,4,0,4"
                                                    Checked="FreeRotateToggle_Checked"
                                                    Style="{StaticResource SmallToggleButton}"
                                                    ToolTip="Click then drag on image to rotate freely"
                                                    Unchecked="FreeRotateToggle_Unchecked">
                                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                        <wpfui:SymbolIcon Margin="0,0,6,0" Symbol="ArrowClockwise24" />
                                                        <TextBlock VerticalAlignment="Center" Text="Free Rotate" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <StackPanel
                                                    Margin="0,4,0,0"
                                                    HorizontalAlignment="Left"
                                                    Orientation="Vertical">
                                                    <wpfui:Button
                                                        x:Name="ApplyRotationButton"
                                                        Width="150"
                                                        Margin="0,0,6,0"
