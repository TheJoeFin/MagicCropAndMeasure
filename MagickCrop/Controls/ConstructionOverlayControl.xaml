<UserControl
    x:Class="MagickCrop.Controls.ConstructionOverlayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!--
        Point handles and per-line paths are added at runtime as DIRECT children of this
        Canvas. MainWindow.HandleMeasurementMouseDown walks Ellipse -> Canvas -> UserControl,
        so nesting the handles any deeper silently breaks dragging.
    -->
    <Canvas x:Name="MeasurementCanvas">
        <!--  The derived shape. Semi-transparent so the transform corner markers stay readable underneath.  -->
        <Path
            x:Name="ShapePath"
            Fill="#26FF6600"
            IsHitTestVisible="False"
            Opacity="0.9"
            Stroke="#FF6600"
            StrokeThickness="2" />

        <!--  Rubber band shown while the Line tool waits for its second click.  -->
        <Line
            x:Name="PreviewLine"
            IsHitTestVisible="False"
            Opacity="0.7"
            Stroke="#0066FF"
            StrokeDashArray="4,3"
            StrokeThickness="2"
            Visibility="Collapsed" />

        <Border
            x:Name="MeasurementText"
            Padding="5,2"
            Background="#7F000000"
            CornerRadius="3"
            ToolTip="Construction measurement options">
            <Border.ContextMenu>
                <ContextMenu Opened="MeasurementContextMenu_Opened">
                    <MenuItem
                        x:Name="ShowShapeMeasurementMenuItem"
                        Click="ShapeMeasurementMenuItem_Click"
                        Header="Show Measurement"
                        IsCheckable="True"
                        IsChecked="True"
                        ToolTip="Show the perimeter and area of the derived shape" />
                    <MenuItem
                        Click="CopyMeasurementMenuItem_Click"
                        Header="Copy Measurement"
                        ToolTip="Copy the perimeter and area values" />
                    <MenuItem
                        Click="RemoveMeasurementMenuItem_Click"
                        Header="Remove Construction"
                        ToolTip="Delete this construction and all its points and lines" />
                </ContextMenu>
            </Border.ContextMenu>
            <Button
                x:Name="MeasurementButton"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Click="MeasurementButton_Click"
                ToolTip="Click to open options">
                <TextBlock
                    x:Name="ConstructionTextBlock"
                    FontWeight="Bold"
                    Foreground="White"
                    TextAlignment="Center" />
            </Button>
        </Border>
    </Canvas>
</UserControl>
