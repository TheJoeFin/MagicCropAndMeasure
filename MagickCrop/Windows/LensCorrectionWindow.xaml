<wpfui:FluentWindow
    x:Class="MagickCrop.Windows.LensCorrectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Lens Correction"
    Width="520"
    Height="560"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <wpfui:TitleBar
            Title="Lens Correction"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="Corrects barrel and pincushion distortion. Positive values pull the edges inward, negative values push them outward."
                TextWrapping="Wrap" />

            <wpfui:InfoBar
                Grid.Row="1"
                Margin="0,12,0,0"
                IsClosable="False"
                IsOpen="{Binding HasDetectedLensDescription}"
                Message="{Binding DetectedLensDescription}"
                Severity="Informational" />

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="Profile" />
                    <ComboBox
                        Grid.Column="1"
                        DisplayMemberPath="Key"
                        ItemsSource="{Binding LensProfiles}"
                        SelectedItem="{Binding SelectedLensProfile, Mode=TwoWay}" />
                </Grid>

                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding AutoDetectLensCorrectionCommand}"
                        Content="Auto from EXIF" />
                    <Button
                        Margin="0,0,8,0"
                        Click="AutoOrientButton_Click"
                        Content="Auto-orient" />
                    <Button Command="{Binding ResetLensCorrectionCommand}" Content="Reset" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="A" />
                    <Slider
                        Grid.Column="1"
                        Maximum="0.5"
                        Minimum="-0.5"
                        Value="{Binding LensCorrectionA, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{Binding LensCorrectionA, StringFormat=F3}" />
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="B" />
                    <Slider
                        Grid.Column="1"
                        Maximum="0.5"
                        Minimum="-0.5"
                        Value="{Binding LensCorrectionB, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{Binding LensCorrectionB, StringFormat=F3}" />
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="C" />
                    <Slider
                        Grid.Column="1"
                        Maximum="0.5"
                        Minimum="-0.5"
                        Value="{Binding LensCorrectionC, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{Binding LensCorrectionC, StringFormat=F3}" />
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <wpfui:TextBox
                        Margin="0,0,8,0"
                        PlaceholderText="Save current settings as profile…"
                        Text="{Binding LensProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding SaveLensProfileCommand}"
                        Content="Save Profile" />
                </Grid>

                <TextBlock
                    Margin="0,12,0,0"
                    Opacity="0.7"
                    Text="The preview uses a downscaled copy for speed. Apply runs at full resolution."
                    TextWrapping="Wrap" />

            </StackPanel>

            <StackPanel
                Grid.Row="4"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <wpfui:Button
                    Margin="0,0,8,0"
                    Appearance="Primary"
                    Click="ApplyButton_Click"
                    Content="Apply" />
                <Button Click="CloseButton_Click" Content="Cancel" />
            </StackPanel>
        </Grid>
    </Grid>
</wpfui:FluentWindow>
